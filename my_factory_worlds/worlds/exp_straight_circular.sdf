<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="exp_straight_circular_world">
    <!-- Experimental world: straight bent 1 to circular bent 2, linked by the BCR arm. Built by make_exp_worlds.py. -->
    <!-- Core Gazebo systems. These are kept from your working circular-conveyor setup. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 18 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.62 0.74 0.86 1</background>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>90 80</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>90 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.50 0.51 0.52 1</ambient>
            <diffuse>0.58 0.59 0.60 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Experimental world: straight bent 1 to circular bent 2
      Bent 1 (pick):          straight, x = -2.58, y = -15.4 .. 5.4, products move +y;
                              collection box 1 past its end (y 5.74 .. 11.46)
      Bent 2 (place):         circular, centre (6, 0), counter-clockwise
      Belt tops:              1.375 m on both bents
      Catch station:          (-2.58, 0.00) on bent 1; place point (2.22, -0.37) on bent 2
      Bins:                   recycling (0, 2.2), trash (0, -2.2)
      The BCR arm at the origin picks from bent 1 and places on bent 2 or drops into a bin.
    -->

    <!-- Left circular factory conveyor with correctly centered moving objects. -->






































    <!--
      Rotating products: one model per product so each one can be picked on its own.
      Each model orbits the left conveyor centre (-6, 0): VelocityControl drives it
      forward (body x) at R*omega while turning at omega, which traces a circle of radius R.
      Generated from the former single-link "left_rotating_products" carrier.
    -->
