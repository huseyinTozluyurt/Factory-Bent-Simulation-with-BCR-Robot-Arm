            <diffuse>0.45 0.45 0.45 1.00</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_counting_gate_marker">
      <static>true</static>
      <pose>9.5000 0.0000 1.392 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 1.10 0.015</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.85 0.10 1.00</ambient>
            <diffuse>0.10 0.85 0.10 1.00</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!--
      Global overhead camera.
      The topic remains /overhead_camera/image so your existing ROS2 bridge and OpenCV node can still work.
    -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0 0 13.0 0 1.5708 0</pose>
      <link name="camera_link">
        <sensor name="rgb_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>/overhead_camera/image</topic>
          <camera>
            <horizontal_fov>1.55</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>60.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>










    <!--
      Side camera: looks across the left bent at belt height, straight at the catch
      station (-2.58, 0), so products cross its view left to right. Used by
      side_camera_checker to cross-check the overhead camera (horizontal view: is an
      object standing on the belt at the station, where, how tall). No collision.
    -->
    <model name="side_camera">
      <static>true</static>
      <pose>-1.50 0 1.80 0 0.17 3.14159</pose>
      <link name="camera_link">
        <visual name="body">
          <geometry>
            <box>
              <size>0.08 0.12 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.10 0.10 1.00</ambient>
            <diffuse>0.10 0.10 0.10 1.00</diffuse>
          </material>
        </visual>
        <sensor name="side_rgb_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>/side_camera/image</topic>
          <camera>
            <horizontal_fov>1.10</horizontal_fov>
            <image>
              <width>640</width>
              <height>360</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>30.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!--
      Release camera: straight above the release zone on the right bent (2.2171, -0.3736),
      used by release_zone_monitor to check the zone is empty before the arm puts an
      object down. No visual and no collision, so the overhead camera does not see it.
    -->
    <model name="release_camera">
      <static>true</static>
      <pose>2.2171 -0.3736 4.5 0 1.5708 0</pose>
      <link name="camera_link">
        <sensor name="release_rgb_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>/release_camera/image</topic>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>30.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Photo booth for the order GUI pictures (capture_product_images puts each product in
         front of it). Away from the bents; must match PHOTO_CAMERA_POSE in product_catalog.py. -->
    <model name="product_photo_camera">
      <static>true</static>
      <pose>0 11 1.6 0 0.5 1.5708</pose>
      <link name="camera_link">
        <sensor name="product_photo_rgb_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>false</visualize>
          <topic>/product_photo_camera/image</topic>
          <camera>
            <horizontal_fov>0.6</horizontal_fov>
            <image>
              <width>512</width>
              <height>512</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>40.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- ===== Trash and recycling bins next to the arm (product_catalog.BINS): open boxes,
         recycling at +y (the arm swings right to it), trash at -y (swings left). ===== -->
