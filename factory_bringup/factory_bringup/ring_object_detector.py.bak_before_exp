#!/usr/bin/env python3
"""
Ring Object Detector - OpenCV detection for the dual circular factory bent.

Pipeline on /overhead_camera/image:
  grayscale -> Gaussian blur -> (intensity threshold OR filled Canny edges)
  -> morphology -> contours inside each ring's belt annulus
  -> minAreaRect -> pixel-to-world on the object top plane.

Publishes:
  /vision/ring1_objects   geometry_msgs/PoseArray (frame "world")
  /vision/ring2_objects   geometry_msgs/PoseArray (frame "world")
  /vision/detections      std_msgs/String (JSON with ring, x, y, yaw, size, area)
  /vision/debug_image     sensor_msgs/Image (annotated bgr8, same view as the window)

With show_window:=true an "Object Detection" window shows the live detections, the
catch-station ROI with the tracked object (from /vision_pick_place/roi), a zoomed
inset and grayscale / Canny thumbnails.
"""

import json
import math
import os

import cv2

import rclpy
from rclpy.node import Node
from cv_bridge import CvBridge
from geometry_msgs.msg import Pose, PoseArray
from sensor_msgs.msg import Image
from std_msgs.msg import String
import rclpy.duration
import rclpy.time
import tf2_ros

from factory_bringup.product_catalog import apply_world_layout
from factory_bringup.vision_geometry import (
    DetectorParams, OverheadCamera, Ring, RingObjectDetector, arm_mask_from_points, compose_detection_view,
)

WINDOW_NAME = "Object Detection"


class RingObjectDetectorNode(Node):
    def __init__(self):
        super().__init__("ring_object_detector")

        self.declare_parameter("image_topic", "/overhead_camera/image")
        self.declare_parameter("publish_debug_image", True)
        self.declare_parameter("show_window", True)
        self.declare_parameter("save_debug_frames_dir", "~/ros2_ws/src/factory_bent_project/debug_frames")

        # Must match <model name="overhead_camera"> in the world file.
        self.declare_parameter("camera_x", 0.0)
        self.declare_parameter("camera_y", 0.0)
        self.declare_parameter("camera_z", 13.0)
        self.declare_parameter("camera_roll", 0.0)
        self.declare_parameter("camera_pitch", 1.5708)
        self.declare_parameter("camera_yaw", 0.0)
        self.declare_parameter("camera_hfov", 1.55)

        # Ring 1 = left bent (pick), ring 2 = right bent (place).
        self.declare_parameter("ring1_name", "ring1")
        self.declare_parameter("ring1_center_x", -6.0)
        self.declare_parameter("ring1_center_y", 0.0)
        self.declare_parameter("ring2_name", "ring2")
        self.declare_parameter("ring2_center_x", 6.0)
        self.declare_parameter("ring2_center_y", 0.0)
        # Belt spans r = 2.95..4.05; its outer edge shows white gaps between segments in the
        # render, so only the product lane (products ride at r = 3.42) is searched.
        self.declare_parameter("ring_inner_radius", 3.10)
        self.declare_parameter("ring_outer_radius", 3.75)

        defaults = DetectorParams()
        for key, value in vars(defaults).items():
            self.declare_parameter(key, value)

        self.bridge = CvBridge()
        self.detector = None
        self.detector_size = None

        self.ring1_pub = self.create_publisher(PoseArray, "/vision/ring1_objects", 10)
        self.ring2_pub = self.create_publisher(PoseArray, "/vision/ring2_objects", 10)
        self.json_pub = self.create_publisher(String, "/vision/detections", 10)
        self.debug_pub = self.create_publisher(Image, "/vision/debug_image", 2)

        self.create_subscription(Image, self.get_parameter("image_topic").value, self.image_callback, 2)
        self.create_subscription(String, "/vision_pick_place/roi", self.on_roi, 5)
        self.create_subscription(String, "/vision_pick_place/status", self.on_status, 5)
        self.roi = None
        self.controller_status = ""

        self.show_window = bool(self.p("show_window"))
        if self.show_window and not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
            self.get_logger().warn("No DISPLAY: the Object Detection window is disabled (debug image is still published).")
            self.show_window = False
        if self.show_window:
            cv2.namedWindow(WINDOW_NAME, cv2.WINDOW_NORMAL)
            cv2.resizeWindow(WINDOW_NAME, 1280, 720)
        self.frame_count = 0

        # The arm is seen from above while it waits over the bent; mask it out so it is
        # never detected as an object. Link frames come from TF (robot_state_publisher),
        # placed in the world with the same base offset the attacher uses.
        self.declare_parameter("mask_arm", True)
        self.declare_parameter("arm_base_frame", "base_link")
        self.declare_parameter("arm_mask_frames", ["link1", "link2", "link3", "link4", "link5", "link6", "flange", "gripper_tip"])
        self.declare_parameter("arm_mask_width", 0.40)
        self.declare_parameter("base_x", -0.200)
        self.declare_parameter("base_y", -0.154)
        self.declare_parameter("base_z", -0.508)
        self.declare_parameter("base_yaw", 0.0)
        # single circular / straight world: ring 1 lane of that belt, no ring 2 (product_catalog.WORLD_LAYOUTS)
        apply_world_layout(self)
        self.tf_buffer = tf2_ros.Buffer()
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer, self)
        self.arm_mask_warned = False
        self.get_logger().info("Ring object detector ready, waiting for images.")

    def p(self, name):
        return self.get_parameter(name).value

    def on_roi(self, msg: String):
        try:
            self.roi = json.loads(msg.data)
        except ValueError:
            self.roi = None

    def on_status(self, msg: String):
        self.controller_status = msg.data

    def arm_points_world(self):
        base = self.p("arm_base_frame")
        bx, by, bz, yaw = (float(self.p(k)) for k in ("base_x", "base_y", "base_z", "base_yaw"))
        c, s = math.cos(yaw), math.sin(yaw)
        pts = [(bx, by, bz)]
        for frame in self.p("arm_mask_frames"):
            try:
                tf = self.tf_buffer.lookup_transform(base, frame, rclpy.time.Time(),
                                                     timeout=rclpy.duration.Duration(seconds=0.0))
            except Exception:
                continue
            t = tf.transform.translation
            pts.append((bx + c * t.x - s * t.y, by + s * t.x + c * t.y, bz + t.z))
        return pts

    def arm_mask(self):
        if not self.p("mask_arm"):
            return None
        pts = self.arm_points_world()
        if len(pts) < 3:
            if not self.arm_mask_warned:
                self.get_logger().warn("Arm link frames not in TF yet; the arm is not masked out of the detections.")
                self.arm_mask_warned = True
            return None
        return arm_mask_from_points(self.detector.camera, pts, float(self.p("arm_mask_width")))

    def build_detector(self, width: int, height: int):
        camera = OverheadCamera(
            x=float(self.p("camera_x")), y=float(self.p("camera_y")), z=float(self.p("camera_z")),
            roll=float(self.p("camera_roll")), pitch=float(self.p("camera_pitch")), yaw=float(self.p("camera_yaw")),
            hfov=float(self.p("camera_hfov")), width=width, height=height,
        )
        rin, rout = float(self.p("ring_inner_radius")), float(self.p("ring_outer_radius"))
        rings = [
            Ring(self.p("ring1_name"), float(self.p("ring1_center_x")), float(self.p("ring1_center_y")), rin, rout),
            Ring(self.p("ring2_name"), float(self.p("ring2_center_x")), float(self.p("ring2_center_y")), rin, rout),
        ]
        params = DetectorParams(**{k: type(v)(self.p(k)) for k, v in vars(DetectorParams()).items()})
        self.detector = RingObjectDetector(camera, rings, params)
        self.detector_size = (width, height)
        self.get_logger().info(
            f"Detector built for {width}x{height}, fx={camera.fx:.1f}px, rings at "
            f"({rings[0].center_x}, {rings[0].center_y}) and ({rings[1].center_x}, {rings[1].center_y})."
        )

    def image_callback(self, msg: Image):
        try:
            bgr = self.bridge.imgmsg_to_cv2(msg, desired_encoding="bgr8")
        except Exception as exc:
            self.get_logger().warn(f"cv_bridge conversion failed: {exc}")
            return

        h, w = bgr.shape[:2]
        if self.detector is None or self.detector_size != (w, h):
            self.build_detector(w, h)

        arm_mask = self.arm_mask()
        detections, _ = self.detector.detect(bgr, exclude_mask=arm_mask)
        ring1_name = self.p("ring1_name")

        arrays = {ring1_name: PoseArray(), self.p("ring2_name"): PoseArray()}
        for arr in arrays.values():
            arr.header.stamp = msg.header.stamp
            arr.header.frame_id = "world"
        for d in detections:
            pose = Pose()
            pose.position.x, pose.position.y, pose.position.z = d.x, d.y, self.detector.params.object_top_z
            pose.orientation.z, pose.orientation.w = math.sin(d.yaw / 2), math.cos(d.yaw / 2)
            arrays[d.ring].poses.append(pose)

        self.ring1_pub.publish(arrays[ring1_name])
        self.ring2_pub.publish(arrays[self.p("ring2_name")])
        self.json_pub.publish(String(data=json.dumps([d.as_dict() for d in detections])))

        if self.p("publish_debug_image") or self.show_window:
            view = compose_detection_view(self.detector, bgr, detections, self.roi, self.controller_status, arm_mask)
            if self.p("publish_debug_image"):
                out = self.bridge.cv2_to_imgmsg(view, encoding="bgr8")
                out.header = msg.header
                self.debug_pub.publish(out)
            if self.show_window:
                cv2.imshow(WINDOW_NAME, view)
                cv2.waitKey(1)

        self.frame_count += 1
        if self.frame_count == 20 and self.p("save_debug_frames_dir"):
            # one raw + one annotated frame, to tune the detector against the real render
            out_dir = os.path.expanduser(self.p("save_debug_frames_dir"))
            os.makedirs(out_dir, exist_ok=True)
            cv2.imwrite(os.path.join(out_dir, "overhead_raw.png"), bgr)
            cv2.imwrite(os.path.join(out_dir, "overhead_detections.png"),
                        compose_detection_view(self.detector, bgr, detections, self.roi, self.controller_status, arm_mask))
            self.get_logger().info(f"Saved debug frames to {out_dir}")
        if self.frame_count % 50 == 1:
            n1 = len(arrays[ring1_name].poses)
            self.get_logger().info(f"frame {self.frame_count}: ring1={n1} objects, ring2={len(detections) - n1} objects")


def main(args=None):
    rclpy.init(args=args)
    node = RingObjectDetectorNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        cv2.destroyAllWindows()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
