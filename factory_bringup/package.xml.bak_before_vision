<?xml version="1.0"?>
<package format="3">
  <name>factory_bringup</name>
  <version>0.0.1</version>
  <description>Bringup launch files for the factory conveyor and BCR robotic arm integration.</description>

  <maintainer email="user@example.com">factory_bent_project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>bcr_arm_gazebo</exec_depend>
  <exec_depend>bcr_arm_moveit_config</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
